# Browser (Vite) — no Google tokens / API keys / Cloud Run hardcodes here
VITE_DISPATCHER_API_BASE=/api/dispatcher
VITE_USE_DISPATCHER_MOCKS=false
VITE_DEFAULT_ROLE=editor
# Required for Lucy login (set to your Extractor ML API base URL)
VITE_EXTRACTOR_ML_API_URL=
VITE_ENVIRONMENT_LABEL=Locale

# Local BFF (server only)
PORT=8787
BFF_PORT=8787
BFF_URL=http://localhost:8787
VITE_ORIGIN=http://localhost:5173
STATIC_DIR=dist

# Required upstream endpoints (no hardcoded Cloud Run fallbacks)
DISPATCHER_API_URL=
DISPATCHER_AUDIENCE=
EXTRACTOR_ML_API_URL=

# Upstream auth adapter:
#   google_id_token (default) | bearer | none
DISPATCHER_AUTH_MODE=google_id_token
# Only for DISPATCHER_AUTH_MODE=bearer
DISPATCHER_BEARER_TOKEN=

# Google ID token for Cloud Run (server-side only). Prefer ADC / metadata in GCP.
# Locally you may set a short-lived token:
#   export GOOGLE_ID_TOKEN="$(gcloud auth print-identity-token --audiences="$DISPATCHER_AUDIENCE")"
GOOGLE_ID_TOKEN=

# Dev-only: skip Lucy session validation (never in production)
BFF_SKIP_LUCY_AUTH=false
BFF_DEFAULT_ROLE=editor
